  "narrative": {
    "northStar": "Camera workspace",
    "overview": "A compact camera workspace puts live video, the reaction image, and gesture instructions in one native desktop window. Matte silver, off-white panels, graphite video framing, and an orange camera action give the controls a quiet, practical hierarchy.",
    "keyCharacteristics": [
      "Native system typography and visible keyboard focus.",
      "Flat surfaces with fine borders and gently rounded corners.",
      "Original reaction images and aspect-ratio-preserving live video.",
      "Explicit camera states and restrained match feedback."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Pair color changes with readable camera or match labels.",
        "section": "colors"
      },
      {
        "name": "The Whole Image Rule",
        "body": "Fit camera and reaction images with `KeepAspectRatio`, centered with letterboxing as needed. Never stretch or crop the original reaction to fill its view.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** keep camera and reaction visible together.",
      "**Do** preserve original image proportions and native keyboard focus.",
      "**Do** pair camera and match colors with readable state labels."
    ],
    "donts": [
      "**Don't** obscure the pose with controls or decorative overlays.",
      "**Don't** substitute browser typography or web layout gates for native Qt verification."
    ]
  }
}
