    {
      "name": "Camera action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Static documentation equivalent of the native camera button, including its control states.",
      "html": "<button class=\"ds-button ds-camera\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"2\" y=\"5\" width=\"14\" height=\"14\" rx=\"2\"/><path d=\"M16 9 22 6V18L16 15\"/></svg>Start camera</button>",
      "css": ".ds-button {font-family:system-ui,sans-serif;font-size:16px;font-weight:500;padding:12px 20px;min-height:52px;border:1px solid #AEB8B2;border-radius:9px;background:#FAFBF9;color:#252B2C;display:inline-flex;align-items:center;gap:8px;} .ds-button:hover {background:#FFFFFF;border-color:#68766E;} .ds-button:active {background:#D7DDD8;} .ds-button:focus-visible {outline:none;border:2px solid #425D79;padding:11px 19px;} .ds-button:disabled {color:#6B756E;background:#D6DCD7;border-color:#B8C2BB;} .ds-camera {min-width:190px;background:#C75517;color:#FFFFFF;border-color:#C75517;} .ds-camera:hover {background:#B84C12;border-color:#B84C12;} .ds-camera:active {background:#9C3F0D;} .ds-camera:focus-visible {border-color:#252B2C;} .ds-camera:disabled {color:#606962;background:#D6DCD7;border-color:#B8C2BB;}"
    },
    {
      "name": "Overlay toggle",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Static checked-state equivalent. Actual toggling is implemented by QPushButton.",
      "html": "<button class=\"ds-button ds-overlay\" aria-pressed=\"true\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M2 12Q12 0 22 12Q12 24 2 12Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>Overlay on</button>",
      "css": ".ds-button {font-family:system-ui,sans-serif;font-size:16px;font-weight:500;padding:12px 20px;min-height:52px;border:1px solid #AEB8B2;border-radius:9px;background:#FAFBF9;color:#252B2C;display:inline-flex;align-items:center;gap:8px;} .ds-button:hover {background:#FFFFFF;border-color:#68766E;} .ds-button:active {background:#D7DDD8;} .ds-button:focus-visible {outline:none;border:2px solid #425D79;padding:11px 19px;} .ds-button:disabled {color:#6B756E;background:#D6DCD7;border-color:#B8C2BB;} .ds-overlay[aria-pressed=\"true\"] {background:#F1F5EE;border-color:#788A79;} .ds-overlay:focus-visible {border-color:#425D79;}"
    },
    {
      "name": "Pose instruction",
      "kind": "card",
      "refersTo": "pose-row",
      "description": "Noninteractive gesture row; matched state uses the native green fill and border.",
      "html": "<div class=\"ds-pose\"><svg width=\"44\" height=\"44\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#252B2C\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><ellipse cx=\"8\" cy=\"11.5\" rx=\"7\" ry=\"8.5\"/><path d=\"M5 9h.01M11 9h.01M4 13Q8 18 12 13\"/><path stroke=\"#C75517\" stroke-width=\"1.6\" d=\"M18 22 16 18V13Q17 11 18 13V5Q18 2 20 3V14Q22 13 22 16L21 21\"/></svg><div><div class=\"ds-pose-title\">Smile + finger up</div><div class=\"ds-pose-copy\">Raise your index finger and smile.</div></div></div>",
      "css": ".ds-pose {font-family:system-ui,sans-serif;display:flex;align-items:center;gap:16px;background:#FAFBF9;color:#252B2C;border:1px solid #D4D9D5;border-radius:10px;padding:16px 18px;min-height:78px;} .ds-pose svg {flex-shrink:0;} .ds-pose-title {font-size:18px;font-weight:600;margin-bottom:6px;} .ds-pose-copy {font-size:14px;color:#505958;} .ds-pose[data-matched=\"true\"] {background:#E3EDE1;border-color:#78976F;}"
